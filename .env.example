# ==============================================================================
# CAREERLY – ENVIRONMENT CONFIGURATION
# 100% Free: ZERO paid AI API keys or billing required.
# ==============================================================================

# 1. Supabase Public Config (Required for client-side Auth & Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Supabase Server-Only Secret (Required for server-side auth & storage)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Optional OpenAI Key (NOT REQUIRED - Careerly operates 100% free with its built-in rule-based engine)
# OPENAI_API_KEY=

# 4. Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=5
